<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. The Compose UI supplies the Material 3 color
         scheme at runtime (including dynamic color on Android 12+). This XML
         theme only styles the window before composition starts. -->
    <style name="Theme.PrescriptionPharmacist" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
