<?xml version="1.0" encoding="utf-8"?>
<!-- Prescription Pharmacist — HTTPS only. Health data must never travel in
     cleartext: all cleartext (http) traffic is blocked on every API level. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
